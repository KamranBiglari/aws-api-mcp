{
  "name": "dynamic-aws-mcp-server",
  "version": "1.0.0",
  "description": "Dynamic AWS MCP Server that supports all AWS services",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "aws-mcp-server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "start:sse": "node dist/serverSSE.js",
    "dev:sse": "tsx src/serverSSE.ts",
    "prepare": "npm run build",
    "install-aws-core": "npm install @aws-sdk/client-s3 @aws-sdk/client-ec2 @aws-sdk/client-lambda @aws-sdk/client-iam @aws-sdk/client-cloudwatch",
    "install-aws-compute": "npm install @aws-sdk/client-ecs @aws-sdk/client-eks @aws-sdk/client-batch @aws-sdk/client-auto-scaling",
    "install-aws-storage": "npm install @aws-sdk/client-s3 @aws-sdk/client-dynamodb @aws-sdk/client-rds @aws-sdk/client-redshift",
    "install-aws-networking": "npm install @aws-sdk/client-route53 @aws-sdk/client-cloudfront @aws-sdk/client-elastic-load-balancing-v2",
    "install-aws-messaging": "npm install @aws-sdk/client-sns @aws-sdk/client-sqs @aws-sdk/client-eventbridge",
    "install-aws-security": "npm install @aws-sdk/client-iam @aws-sdk/client-cognito-identity @aws-sdk/client-cognito-identity-provider @aws-sdk/client-secrets-manager",
    "install-aws-monitoring": "npm install @aws-sdk/client-cloudwatch @aws-sdk/client-cloudwatch-logs @aws-sdk/client-cloudtrail",
    "install-aws-devtools": "npm install @aws-sdk/client-codebuild @aws-sdk/client-codedeploy @aws-sdk/client-codecommit @aws-sdk/client-codepipeline",
    "install-aws-all": "npm run install-aws-core && npm run install-aws-compute && npm run install-aws-storage && npm run install-aws-networking && npm run install-aws-messaging && npm run install-aws-security && npm run install-aws-monitoring && npm run install-aws-devtools"
  },
